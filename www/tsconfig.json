{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client", "@solidjs/vite-plugin/virtual-modules"],
    "paths": {
      "~/*": ["./src/*"],
      "solid-route-progress": ["../src/index.ts"],
      "solid-route-progress/router": ["../src/router.tsx"],
      "solid-route-progress/navigation": ["../src/navigation.tsx"]
    }
  },
  "include": ["src", "file-routes.d.ts", "vite.config.ts", "llms.ts", "showcase.ts"]
}
